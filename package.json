{
  "name": "code-archaeologist",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/api/server.js",
    "server": "node server/api/server.js",
    "build": "npm run build --prefix client",
    "client": "npm run dev --prefix client",
    "analyst": "node server/agents/repositoryAnalyst.js",
    "diagnosis:test": "node --test tests/diagnosisAgent.test.js",
    "fix:test": "node --test tests/fixAgent.test.js",
    "qa:test": "node --test tests/qaAgent.test.js",
    "test": "node --test tests/*.test.js",
    "review:test": "node --test tests/reviewAgent.test.js"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/langgraph": "^1.4.17",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  }
}
